{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"C:/Users/leona/DARTGALLERY/graphify-out/graph.json\" ] && cd \"C:/Users/leona/DARTGALLERY\" && graphify update . 2>&1 | tail -5 || true",
            "timeout": 180,
            "statusMessage": "Refreshing graphify knowledge graph…"
          }
        ]
      }
    ]
  }
}
