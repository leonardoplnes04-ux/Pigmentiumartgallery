# Variables del sitio (sin valores). Copia a .env.local para desarrollo.

# Convex (ya existentes)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Google Analytics 4 (solo Production en Vercel)
NEXT_PUBLIC_GA_ID=

# Vista previa del trabajo SEO/IA (rama seo-ia-2026-11): 1 = encendida
NEXT_PUBLIC_SEO_PREVIEW=

# Verificación de buscadores (Search Console / Bing Webmaster). Vacías = no se publica nada.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# /api/imagen-obra (Vercel). Sin RESEND_API_KEY en local, la imagen se guarda
# en .verify/imagen-obra-ultima.jpg en lugar de enviarse.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=
IP_SALT=
